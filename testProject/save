#include "../includes/buffer.h"
#include "../includes/dynamicMem.h"
#include "../includes/rk4.h"
#include "../includes/sleep.h"
#include <unistd.h>
#include <stdlib.h>
#include <math.h>
#include <gravity.h>

#define PI 3.14159265359

ParticleSystem sys = {0};

static void floatConverter(int writeIndex)
{
    RenderParticle *target = buffers[writeIndex];
    for (int i = 0; i < PARTICLE_COUNT; ++i)
    {
        target[i].x = (float)sys.p[i].x.x;
        target[i].y = (float)sys.p[i].x.y;
        target[i].r = (float)sys.p[i].r;
    }
}

void initPhysicsData(void)
{

    sys.n = PARTICLE_COUNT;
    creParticleSystem(&sys);

    for (int i = 0; i < BUF_COUNT; ++i)
    {
        buffers[i] = creDy(BUF_COUNT, sizeof(RenderParticle));
    }

    sys.p[0].m = 1;
    sys.p[0].r = 0.1;
    sys.p[0].x.x = 0;
    sys.p[0].x.y = 0.0;
    sys.p[0].v.x = 0.0;
    sys.p[0].v.y = 0;
    sys.p[1].m = 3.004e-6;
    sys.p[1].r = 0.03;
    sys.p[1].x.x = 0.983310;
    sys.p[1].x.y = 0.0;
    sys.p[1].v.x = 0.0;
    sys.p[1].v.y = 0.0;

    double rAfelium = 1.016682;
    double aEarth = (sys.p[1].x.x + rAfelium) / 2.0;
    double muEarth = G_CONSTANT * (sys.p[0].m + sys.p[1].m);

    sys.p[1].v.y = sqrt(muEarth * (2.0 / sys.p[1].x.x - 1.0 / aEarth));

    double total_mass = 0.0;
    double cm_x = 0.0;
    double cm_y = 0.0;
    double p_x = 0.0;
    double p_y = 0.0;

    for (int i = 0; i < sys.n; i++)
    {
        total_mass += sys.p[i].m;
        cm_x += sys.p[i].m * sys.p[i].x.x;
        cm_y += sys.p[i].m * sys.p[i].x.y;
        p_x += sys.p[i].m * sys.p[i].v.x;
        p_y += sys.p[i].m * sys.p[i].v.y;
    }

    double offset_x = cm_x / total_mass;
    double offset_y = cm_y / total_mass;
    double vel_offset_x = p_x / total_mass;
    double vel_offset_y = p_y / total_mass;

    for (int i = 0; i < sys.n; i++)
    {
        sys.p[i].x.x -= offset_x;
        sys.p[i].x.y -= offset_y;
        sys.p[i].v.x -= vel_offset_x;
        sys.p[i].v.y -= vel_offset_y;
    }

    sys.t = 0.0;

    atomic_init(&guardIndex, 2);

    printf("Physics initialized.\n");
}

void destroyPhysicsData(void)
{
    remParticleSystem(&sys);
    for (int i = 0; i < BUF_COUNT; ++i)
    {
        free(buffers[i]);
    }
}

void *physicCaluclate(void *args)
{
    double dt = 0.25 / (double)(365.256363004 * 24.0 * 3600.0);
    int writeIndex = 0;
    double lasty = 0.0;
    while (appRunning)
    {
        lasty = sys.p[1].x.y;
        rk4Step(&sys, dt);
        // if (sys.p[1].x.y - lasty > 0 && -lasty > 0)
        // {
            double r = sqrt(sys.p[1].x.x * sys.p[1].x.x + sys.p[1].x.y * sys.p[1].x.y);

            printf("lasty: %lf, y: %lf, y-lasty: %lf r: %lf, T: %lf | %lf time: %lf\n", lasty, sys.p[1].x.y, sys.p[1].x.y-lasty, r, (sys.t * 365.256363004) - 365.256363004, sys.t * 365.256363004, sys.t);
        // }
        if(sys.t >= 1.000001) {
            fsync(1);
            exit(EXIT_SUCCESS);
        }
        floatConverter(writeIndex);

        writeIndex = atomic_exchange(&guardIndex, writeIndex);

        UsSleep(500);
    }
}